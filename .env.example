OPENROUTER_API_KEY=your_openrouter_key_here
DEEPINFRA_TOKEN=your_deepinfra_token_here
TAVILY_API_KEY=your_tavily_key_here
OBSIDIAN_API_KEY=your_obsidian_rest_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides. Keep these in .env so providers can be changed without code edits.
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-r1-distill-llama-70b:free
GEMINI_MODEL=gemini-3.5-flash-lite
